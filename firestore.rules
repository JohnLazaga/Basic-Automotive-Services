rules_version = '2';
/* ============================================================================
   Multi-tenant rules — every branch's data lives under branches/{b}/...
   A user belongs to a branch iff branches/{b}/users/{uid} exists and is active.
   The shop owner (by email) is a super-admin across every branch.
   One branch's data is completely walled off from another's.

   PREMISES GATE (see password-reset-kit/functions/shop-session.js)
   Being signed in is not enough: a non-admin also needs a live session document
   at branches/{b}/sessions/{uid}, which ONLY the Admin SDK can write and which
   the startShopSession function issues only when the request comes from one of
   the branch's trusted networks. A worker who copies his saved password out of
   the browser and signs in from home therefore reads nothing.

   The gate is dormant until branches/{b}/meta/network.enforce == true, so
   deploying these rules cannot lock a shop out. Trust the shop network first.
   ========================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'johnlazaga1980@yahoo.com';
    }
    function acctPath(b) {
      return /databases/$(database)/documents/branches/$(b)/users/$(request.auth.uid);
    }
    function sessPath(b) {
      return /databases/$(database)/documents/branches/$(b)/sessions/$(request.auth.uid);
    }
    function netPath(b) {
      return /databases/$(database)/documents/branches/$(b)/shopnet/network;
    }
    function memberOf(b) {
      return request.auth != null
             && exists(acctPath(b))
             && get(acctPath(b)).data.active != false;
    }
    function adminOf(b) {
      return memberOf(b) && get(acctPath(b)).data.isAdmin == true;
    }

    /* Is the premises gate switched on for this branch? Absent doc / absent
       field == off, so the gate stays dormant until an admin enables it. */
    function enforcingPremises(b) {
      return exists(netPath(b)) && get(netPath(b)).data.get('enforce', false) == true;
    }
    /* A live, unexpired shop session. The default makes a session document that
       only carries a denial stamp (no expiresAt) evaluate as expired. */
    function hasShopSession(b) {
      return exists(sessPath(b))
             && get(sessPath(b)).data.get('expiresAt', request.time) > request.time;
    }
    /* Admins and the owner work from home by design; everyone else must hold a
       session issued from a trusted shop network. */
    function onPremises(b) {
      return !enforcingPremises(b)
             || isOwner()
             || get(acctPath(b)).data.get('isAdmin', false) == true
             || hasShopSession(b);
    }
    /* The check that guards real shop data: an active member, on the premises. */
    function activeMember(b) {
      return memberOf(b) && onPremises(b);
    }

    /* ---- Branch container doc (metadata only) ---- */
    match /branches/{b} {
      allow read:  if isOwner() || memberOf(b);
      allow write: if isOwner();

      /* Operational data — staff, bays, parts, labor, vehicles, estimates,
         jobs, appointments, purchaseOrders, catalog. Members of the branch
         read/write; 'users', 'meta' and 'sessions' are handled by their own
         stricter rules below (excluded here so members can't edit accounts,
         shop settings, the trusted-network list, or their own session). */
      match /{coll}/{doc} {
        allow read, write: if (isOwner() || activeMember(b))
                              && coll != 'users' && coll != 'meta'
                              && coll != 'portal' && coll != 'appt_requests'
                              && coll != 'portal_claims'
                              && coll != 'sessions' && coll != 'shopnet';
      }

      match /meta/shop {
        allow read:  if isOwner() || activeMember(b);
        allow write: if isOwner() || adminOf(b);
      }

      /* Counters (orcounter/jocounter/estcounter/pocounter/counters) — any
         active member on the premises may run the allocation transaction.
         'shop' is excluded so the admin-only rule above actually holds: rules
         OR together, so without this exclusion a broad grant here would hand
         write access to shop settings straight back to every member.

         This exclusion is only possible because the client watches meta/shop
         and meta/counters as two DOCUMENT listeners (part11_cloud.js). A
         listener on the whole meta collection is a `list`, which cannot satisfy
         a document-id condition — reintroducing one would break live sync. Keep
         meta reads document-scoped. (The same constraint is why the
         trusted-network list lives in its own shopnet collection.) */
      match /meta/{doc} {
        allow read, write: if (isOwner() || activeMember(b)) && doc != 'shop';
      }

      /* Trusted networks for the premises gate. Readable so the Settings screen
         can show them; writable ONLY by the Cloud Functions (Admin SDK), never
         by a client — otherwise a worker would simply add his home address. */
      match /shopnet/{doc} {
        allow read:  if isOwner() || memberOf(b);
        allow write: if false;
      }

      /* Shop sessions — issued by startShopSession (Admin SDK) only. A member
         may read their own to see when it expires; nobody may write one. */
      match /sessions/{uid} {
        allow get:   if isOwner() || adminOf(b) || (request.auth != null && request.auth.uid == uid);
        allow list:  if isOwner() || adminOf(b);
        allow write: if false;
      }

      /* Accounts — a member reads their own doc; admins list/manage all.
         Deliberately NOT premises-gated: the app must resolve who you are
         before it can ask for a shop session, and the sign-in screen would
         otherwise deadlock. Reading your own name/role reveals no shop data.
         (Bootstrap of a branch's first admin is done by the owner.) */
      match /users/{uid} {
        allow get:   if isOwner() || adminOf(b) || (request.auth != null && request.auth.uid == uid);
        allow list:  if isOwner() || adminOf(b);
        allow write: if isOwner() || adminOf(b);
      }

      /* Public customer portal — anyone may read the minimal snapshot; only
         branch members publish. */
      match /portal/{doc} {
        allow read:  if true;
        allow write: if isOwner() || activeMember(b);
      }

      /* Customer appointment requests — anonymous create (validated), staff manage.

         This is the only collection an unauthenticated stranger can write to, so
         it is the shop's whole public attack surface. It was previously validated
         on three fields with NO hasOnly clause, which let anyone attach arbitrary
         extra fields up to the 1 MB document limit. Every accepted key is now
         listed and individually bounded, so the largest document a stranger can
         create is roughly 1.4 KB.

         What this does NOT do is stop someone submitting thousands of *valid*
         requests — rules cannot rate-limit. That needs App Check, which must be
         rolled out to the clients BEFORE it is required here or every existing
         device breaks at once. See FIRESTORE_RULES.md, "Phase 2". */
      match /appt_requests/{doc} {
        allow create: if request.resource.data.keys().hasOnly(
                           ['name','contact','notes','status','source','createdAt',
                            'plate','vehicle','vehicleId','preferredDate'])
                      && request.resource.data.keys().hasAll(['name','contact','status'])
                      && request.resource.data.status == 'new'
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() < 120
                      && request.resource.data.contact is string
                      && request.resource.data.contact.size() > 0
                      && request.resource.data.contact.size() < 60
                      && request.resource.data.get('notes','') is string
                      && request.resource.data.get('notes','').size() < 1000
                      && request.resource.data.get('source','') is string
                      && request.resource.data.get('source','').size() < 24
                      && request.resource.data.get('plate','') is string
                      && request.resource.data.get('plate','').size() < 24
                      && request.resource.data.get('vehicle','') is string
                      && request.resource.data.get('vehicle','').size() < 120
                      && request.resource.data.get('vehicleId','') is string
                      && request.resource.data.get('vehicleId','').size() < 64
                      && request.resource.data.get('preferredDate','') is string
                      && request.resource.data.get('preferredDate','').size() <= 10
                      /* createdAt may be an ISO string OR a real Timestamp.
                         A web client reaching for serverTimestamp() or passing a
                         Date writes a Timestamp, and calling .size() on one is an
                         evaluation ERROR, which denies the whole write — a silent
                         permission-denied that looks like a broken endpoint. The
                         string branch is tested first and && short-circuits, so
                         .size() never runs on a non-string.
                         preferredDate is deliberately string-only: the staff app
                         uses it verbatim as the appointment date and needs
                         'YYYY-MM-DD'. */
                      && ( ( request.resource.data.get('createdAt','') is string
                             && request.resource.data.get('createdAt','').size() <= 32 )
                           || request.resource.data.get('createdAt', request.time) is timestamp );
        allow read, update, delete: if isOwner() || activeMember(b);
      }

      /* Customer portal PIN self-claim — anonymous create (validated), staff read/delete. */
      match /portal_claims/{claim} {
        allow create: if request.resource.data.keys().hasOnly(['vehicleId','pin','ts'])
                      && request.resource.data.pin is string
                      && request.resource.data.pin.size() >= 4
                      && request.resource.data.pin.size() <= 6;
        allow read, delete: if isOwner() || activeMember(b);
        allow update: if false;
      }
    }

    /* Everything not explicitly matched is denied. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
